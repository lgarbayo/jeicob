# Copia este fichero a `.env` y rellena tu clave.
# El SDK de Anthropic la lee automáticamente desde el entorno.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo por defecto del agente (Claude Opus 4.8).
JEICOB_MODEL=claude-opus-4-8

# Rutas de datos (opcionales). Las relativas se resuelven contra JEICOB_HOME
# (por defecto, la raíz del repo), no contra el directorio de trabajo.
QDRANT_PATH=./.qdrant_data

# Qdrant en servidor (opcional, ver docker-compose.yml). Con QDRANT_URL se
# ignora QDRANT_PATH y varios procesos pueden compartir la base.
# Pon los valores sin comentarios detrás: `VAR=   # texto` toma el texto como valor.
# API key (genera una con: openssl rand -hex 32):
# QDRANT_API_KEY=
# QDRANT_URL=http://localhost:6333
# JEICOB_HOME=/ruta/a/jeicob
# JEICOB_KB_DIR=./knowledge_base
# JEICOB_OUTPUT_DIR=./docs_output
# FASTEMBED_CACHE_PATH=./.fastembed_cache

# Salida a internet: afecta al CLI (Claude y Ollama) y al servidor MCP.
# JEICOB_ENABLE_NETWORK=1            # 0 = sin search/download_reference ni peticiones salientes
# Descargas (jeicob/netguard.py)
# JEICOB_DOWNLOAD_ALLOWED_HOSTS=arxiv.org,semanticscholar.org
# JEICOB_ALLOW_PRIVATE_NETWORK=0     # 1 = permitir descargas desde la intranet

# Servidor MCP (jeicob/mcp_server.py), todas opcionales.
# JEICOB_QDRANT_IDLE_RELEASE=30      # s sin uso antes de soltar el lock de Qdrant
# JEICOB_QDRANT_LOCK_TIMEOUT=10      # s esperando si otro proceso tiene el lock
# JEICOB_MCP_PREFETCH=1              # precarga el modelo de embeddings al arrancar
# Transporte HTTP (jeicob-mcp --transport http):
# Token obligatorio, ≥ 32 caracteres (genera uno con: openssl rand -hex 32):
# JEICOB_MCP_TOKEN=
# JEICOB_MCP_HOST=127.0.0.1          # otra interfaz expone el servidor sin TLS
# JEICOB_MCP_PORT=8765
