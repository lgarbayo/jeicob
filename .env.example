# Copia este fichero a `.env` y rellena tu clave.
# El SDK de Anthropic la lee automáticamente desde el entorno.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo por defecto del agente (Claude Opus 4.8).
JEICOB_MODEL=claude-opus-4-8

# Rutas de datos (opcionales). Las relativas se resuelven contra JEICOB_HOME
# (por defecto, la raíz del repo), no contra el directorio de trabajo.
QDRANT_PATH=./.qdrant_data
# JEICOB_HOME=/ruta/a/jeicob
# JEICOB_KB_DIR=./knowledge_base
# JEICOB_OUTPUT_DIR=./docs_output
# FASTEMBED_CACHE_PATH=./.fastembed_cache
